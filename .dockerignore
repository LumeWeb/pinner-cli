# Build context exclusions for the Docker image. The MCP Apps bundles/theme are
# served from the go.lumeweb.com/pinner/canvasassets module, not the CLI's own
# embedded copy, so no app asset step is required here.

# VCS / environment
.git
.gitignore
**/.git
.worktrees
.hermes

# Dependency + build artifacts
node_modules
bin
dist
/tmp

# Scratch / logs
*.log
vault
backup
