# Build context exclusions for the Docker image.
# NOTE: internal/mcpapp/appsassets/dist/*.js must NOT be excluded — the Go
# embed requires them at build time (regenerated by `make jsbuild`).

# VCS / environment
.git
.gitignore
**/.git
.worktrees
.hermes

# Dependency + build artifacts
node_modules
packages/*/node_modules
packages/apps/node_modules
packages/*/dist
bin
dist
/tmp

# Scratch / logs
*.log
vault
backup
