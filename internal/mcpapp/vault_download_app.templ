package mcpapp

// VaultDownloadAppForm renders the visible "Download from Vault" view body: the
// vault path + name + output + sink form, the live status line, and the result
// readout (a download link for sink=drop, or the written host path for
// sink=local). The document <head> (shared inline Tailwind theme) and the ESM
// module <script> (shared ext-apps bootstrap + download logic) are supplied by
// renderMcpAppDoc, so this templ authors only the app-specific markup.
templ VaultDownloadAppForm() {
	<div class="app-shell">
		<h1 class="app-title">Download from Vault</h1>
		<form id="vault-download-form" class="mt-2">
			<label for="vault-source" class="form-label">Vault file path</label>
			<input id="vault-source" name="source" class="form-input" placeholder="vault:/docs/report.pdf" autocomplete="off"/>
			<label for="name" class="form-label">Name (optional)</label>
			<input id="name" name="name" class="form-input" placeholder="report.pdf" autocomplete="off"/>
			<label for="output" class="form-label">Host output path (optional)</label>
			<input id="output" name="output" class="form-input" placeholder="/data/out/report.pdf" autocomplete="off"/>
			<fieldset class="mt-2">
				<legend class="form-label">Where to write the bytes</legend>
				<label class="inline"><input id="sink-local" name="sink" type="radio" value="local" checked="checked"/> Local host path</label>
				<label class="inline"><input id="sink-drop" name="sink" type="radio" value="drop"/> Filedrop link</label>
			</fieldset>
			<button type="submit" class="btn-primary" id="start">Download</button>
		</form>
		<div id="vault-download-status" class="status"></div>
		<div class="card" style="display:none">
			<a id="out-link" href="#" class="text-accent" download="">Save file</a>
		</div>
		<div class="card" style="display:none">
			Local path: <code id="out-path" class="mono text-accent">—</code>
		</div>
	</div>
}
