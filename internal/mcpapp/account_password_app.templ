package mcpapp

// AccountPasswordAppForm renders the visible "Change Password" view body: a
// start button, a deep-link readout for the one-time password change page, and
// a status line. The document <head> (shared inline theme) and the ESM module
// <script> (shared ext-apps bootstrap + account-password logic) are supplied by
// renderMcpAppDoc, so this templ authors only the app-specific markup.
templ AccountPasswordAppForm() {
	<h1>Change Password</h1>
	<p class="muted">Mint a one-time page to change your Pinner password. The change runs in your browser; your password never reaches this chat.</p>
	<button type="button" id="pw-start">Start password change</button>
	<div class="result">
		<a id="pw-url" href="#" class="link" style="display:none"></a>
	</div>
	<div id="pw-status" class="status"></div>
}
