package mcpapp

// vaultBrowserAppForm renders the visible "Vault browser" view body: a status
// line, the current path label, an up/root/refresh button row, and the listing
// container. Navigation buttons and the listing are wired by the vault-browser
// ESM bundle. The document <head> (shared inline theme) and the ESM module
// <script> (shared ext-apps bootstrap + browser logic) are supplied by
// renderMcpAppDoc, so this templ authors only the app-specific markup.
templ VaultBrowserAppForm() {
	<h1>Vault</h1>
	<div id="vault-status" class="status"></div>
	<div class="browser-path">
		<span id="vault-path" class="path-label">vault:/</span>
		<div class="browser-tools">
			<button type="button" id="vault-up" disabled>Up</button>
			<button type="button" id="vault-root" disabled>Root</button>
			<button type="button" id="vault-refresh" disabled>Refresh</button>
		</div>
	</div>
	<ul id="vault-list" class="browser-list"></ul>
	<p id="vault-empty" class="browser-empty" hidden></p>
}
