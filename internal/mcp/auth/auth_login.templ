package auth

import "go.lumeweb.com/pinner-cli/internal/mcp/core/handoff"

// authLoginPageData carries the fields needed to render the out-of-band login
// page for a pending request.
type authLoginPageData struct {
	Action    string // form POST target
	Email     string
	CSRFToken string // per-request secret bound to this login; required on POST
	OTPStage  bool
	Error     string
}

templ authLoginPage(data authLoginPageData) {
	@handoff.BrandLayout("Sign in to Pinner") {
		<div class="brand-card">
			<h1 class="brand-card-title">Sign in to Pinner</h1>
			<p class="brand-card-text">
				Authenticate to enable this MCP server. Enter the account email and
				password. Credentials are entered here and never exposed to the
				requesting client.
			</p>
			<form method="post" action={ data.Action }>
				<input type="hidden" name="csrf" value={ data.CSRFToken }/>
				<label class="brand-label" for="email">Email</label>
				<input class="brand-input" type="email" id="email" name="email" value={ data.Email } required autofocus autocomplete="email" spellcheck="false"/>
				<label class="brand-label" for="password">Password</label>
				<input class="brand-input" type="password" id="password" name="password" required autocomplete="current-password"/>
				if data.OTPStage {
					<label class="brand-label" for="otp">Two-factor code</label>
					<input class="brand-input" type="text" id="otp" name="otp" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*"/>
				}
				if data.Error != "" {
					<p class="status-error">{ data.Error }</p>
				}
				<button class="brand-btn" type="submit">{ "Authorize" }</button>
			</form>
		</div>
	}
}

// authSuccessPage confirms an out-of-band login completed.
templ authSuccessPage() {
	@handoff.BrandLayout("Signed in") {
		<div class="brand-card">
			<h1 class="brand-card-title">Signed in</h1>
			<p class="brand-card-text">Authentication complete. You can close this tab and return to your client.</p>
		</div>
	}
}
