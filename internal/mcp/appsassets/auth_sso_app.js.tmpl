// Auth SSO MCP App module (Go text/template).
//
// Pulls in the shared ext-apps bootstrap first, then authors ONLY the sign-in
// behavior: start an out-of-band login, surface the human-only approval URL,
// and poll the app-only auth_sso_status helper until done. Values injected by
// mcpAppModule: .ClientB64, .Name, .Version.
{{template "mcpBootstrap" .}}
const CLIENT_B64 = "{{.ClientB64}}";

const startBtn = $("#sso-start");
const urlEl = $("#sso-url");
const statusEl = $("#sso-status");

extAppsConnect(CLIENT_B64, "{{.Name}}", "{{.Version}}").then((app) => {
  startBtn.addEventListener("click", () => startSignIn(app));
}).catch((err) => {
  setStatus(statusEl, "error", "Could not connect to host: " +
    (err && err.message ? err.message : err));
});

function startSignIn(app) {
  setStatus(statusEl, "pending", "Starting sign-in...");
  app.callServerTool({ name: "auth_sso", arguments: {} }).then((res) => {
    const sc = res && res.structuredContent;
    if (!sc || sc.status !== "needs_human") {
      setStatus(statusEl, "error",
        "Auth did not return an approval handoff. " +
        (res && res.isError ? " (error)" : ""));
      if (sc && sc.status === "done") {
        setStatus(statusEl, "ok", "Already signed in.");
      }
      return;
    }
    const url = sc.action_url;
    if (url) {
      urlEl.textContent = url;
      urlEl.setAttribute("href", url);
    }
    setStatus(statusEl, "pending", "Sign-in pending. Open the approval link in your browser.");
    pollStatus(app, sc.handle, 60);
  }).catch((err) => {
    setStatus(statusEl, "error", "Could not start sign-in: " +
      (err && err.message ? err.message : err));
  });
}

function pollStatus(app, handle, attempts) {
  let max = attempts || 60;
  return app.callServerTool({
    name: "auth_sso_status",
    arguments: { handle },
  }).then((res) => {
    const sc = res && res.structuredContent;
    const status = sc && sc.status;
    if (status === "done") {
      setStatus(statusEl, "ok", "Signed in.");
      return;
    }
    // auth_sso_status reports needs_human both while a sign-in is still live
    // (it carries an action_url to approve) and when the handle has become a
    // dead end (unknown/expired/failed/no continuation). A pending hand-off
    // always includes an action_url; a dead/expired/failed one never does and
    // steers toward restart via resume_tool/detail. When polling cannot
    // succeed, surface the restart guidance instead of retrying for ~90s.
    if (status === "needs_human" && !sc.action_url) {
      const detail = sc.detail || "Sign-in no longer active.";
      const restart = sc.resume_tool || "auth_sso";
      setStatus(statusEl, "info", detail + " Click start to " + restart + " again.");
      return;
    }
    if (status === "needs_human") {
      setStatus(statusEl, "pending", "Waiting for approval in the browser...");
    }
    if (--max <= 0) {
      setStatus(statusEl, "info", "Timed out waiting for approval. Click start to retry.");
      return;
    }
    window.setTimeout(() => pollStatus(app, handle, max), 1500);
  }).catch(() => {
    if (--max > 0) {
      window.setTimeout(() => pollStatus(app, handle, max), 1500);
    } else {
      setStatus(statusEl, "info", "Timed out polling sign-in status.");
    }
  });
}
