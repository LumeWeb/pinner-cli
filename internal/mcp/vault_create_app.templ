package mcp

// vaultCreateAppForm renders the visible "Create Vault" view body: a start
// button, the create URL readout (deep-linked to the human-only one-time page
// where the Sia device approval and seed reveal happen), and a live status
// line that polls the app-only vault_create_status helper until done. The
// document <head> (shared inline theme) and the ESM module <script> (shared
// ext-apps bootstrap + create logic) are supplied by renderMcpAppDoc, so this
// templ authors only the app-specific markup.
templ vaultCreateAppForm() {
	<h1>Create Vault</h1>
	<button id="vault-create-start" type="button">Start vault create</button>
	<div class="result">
		Setup: <a id="vault-create-url" href="#" target="_blank" rel="noopener">pending</a>
	</div>
	<div id="vault-create-status" class="status"></div>
}
