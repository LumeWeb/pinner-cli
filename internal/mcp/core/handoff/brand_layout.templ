package handoff

templ BrandLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Pinner</title>
			<link rel="stylesheet" href={ BrandCSSURL() }/>
		</head>
		<body class="brand-body">
			<a class="brand-mark" href="https://pinner.xyz" target="_blank" rel="noopener" aria-label="Pinner — pinner.xyz">
				<img class="brand-logo" src={ BrandLogoURL() } alt="Pinner logo" width={ 36 } height={ 36 }/>
			</a>
			{ children... }
			<div class="brand-foot">This server runs tools in-process under your PINNER account.</div>
			<script>
				// Disable and mark the submit button as processing while a form
				// POST is in flight, so an OAuth/authorize no-op or slow round
				// trip doesn't get double-submitted. Progressive enhancement:
				// with JavaScript off the form still submits normally.
				document.addEventListener("submit", function (e) {
					var f = e.target;
					if (!f || !f.matches("form")) return;
					var btn = f.querySelector("button[type=submit]");
					if (!btn) return;
					btn.disabled = true;
					btn.classList.add("processing");
					if (!btn.querySelector(".spin")) {
						var s = document.createElement("span");
						s.className = "spin";
						s.setAttribute("aria-hidden", "true");
						btn.prepend(s);
					}
				});
				// Copy the full recovery seed from the seed-card's data-seed
				// attribute (the complete mnemonic, not the visually-rendered
				// word grid) to the clipboard. Prefer navigator.clipboard when
				// available, but ALWAYS fall through to a textarea + execCommand
				// path on rejection (permission denied / restricted API), so a
				// locked clipboard still yields a useable copy instead of a
				// bare "Copy failed".
				window.copySeed = function (btn) {
					var card = btn.closest(".seed-card");
					if (!card) return;
					var text = (card.getAttribute("data-seed") || "").trim();
					var label = function (ok) {
						var txt = btn.textContent;
						btn.textContent = ok ? "Copied" : "Copy failed";
						btn.classList.toggle("copied", ok);
						setTimeout(function () {
							btn.textContent = txt;
							btn.classList.remove("copied");
						}, 1500);
					};
					var fallback = function () {
						var ta = document.createElement("textarea");
						ta.value = text;
						ta.style.position = "fixed";
						ta.style.opacity = "0";
						document.body.appendChild(ta);
						ta.select();
						var ok = false;
						try {
							ok = document.execCommand("copy");
						} catch (e) {
							ok = false;
						}
						document.body.removeChild(ta);
						label(ok);
					};
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(
							function () {
								label(true);
							},
							function () {
								fallback();
							},
						);
						return;
					}
					fallback();
				};
			</script>
		</body>
	</html>
}
