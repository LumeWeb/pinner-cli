package mcp

// pinCreateAppForm renders the visible "Create a Pin" view body: the CID/name
// form, the live status line, and the result readout. The document <head>
// (shared inline theme) and the ESM module <script> (shared ext-apps
// bootstrap + pin logic) are supplied by renderMcpAppDoc, so this templ
// authors only the app-specific markup.
templ pinCreateAppForm() {
	<h1>Create a Pin</h1>
	<form id="pin-form">
		<label for="cid">CID</label>
		<input id="cid" name="cid" placeholder="bafy..." autocomplete="off" spellcheck="false"/>
		<label for="name">Name (optional)</label>
		<input id="name" name="name" placeholder="my-file" autocomplete="off"/>
		<button type="submit">Pin</button>
	</form>
	<div id="pin-status" class="status"></div>
	<div class="result">
		CID: <code id="out-cid">—</code>
		<br/>
		Status: <code id="out-status">—</code>
	</div>
}
